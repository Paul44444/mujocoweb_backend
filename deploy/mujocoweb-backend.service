[Unit]
Description=MuJoCo Web GPU Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paul
Group=paul
WorkingDirectory=/home/paul/PycharmProjects/dapg
EnvironmentFile=-/home/paul/PycharmProjects/dapg/.env
Environment=MUJOCO_GL=egl
Environment=PYOPENGL_PLATFORM=egl
Environment=CUDA_VISIBLE_DEVICES=0
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=SIMULATION_WIDTH=960
Environment=SIMULATION_HEIGHT=720
Environment=JPEG_QUALITY=85
Environment=STREAM_FPS=30
ExecStart=/home/paul/miniconda3/envs/dapg38/bin/python -m uvicorn server:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
