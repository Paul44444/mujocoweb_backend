# Keep secrets only in this local file. `.env` is ignored by Git.
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-5-mini

PORT=8000
FRONTEND_ORIGINS=https://mujocoweb.vercel.app,http://localhost:5173

# Local NVIDIA/headless rendering (use osmesa for a CPU-only fallback)
MUJOCO_GL=egl
PYOPENGL_PLATFORM=egl
CUDA_VISIBLE_DEVICES=0
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# Sharp 4:3 stream tuned for the local RTX 3060
SIMULATION_WIDTH=960
SIMULATION_HEIGHT=720
JPEG_QUALITY=85
STREAM_FPS=30
