                uniform token info:id = "UsdPrimvarReader_float3"
                string inputs:varname = "displayColor"
                float3 outputs:result
            }
            def Shader "Surface" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Incubator/Looks/Paint/Color.outputs:result>
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
        def Material "Glass" {
            token outputs:surface.connect = </Incubator/Looks/Glass/Surface.outputs:surface>
            def Shader "Surface" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.56, 0.79, 0.85)
                float inputs:opacity = 0.25
                float inputs:roughness = 0.15
                token outputs:surface
            }
        }
    }
